{
  "name": "browser-profile-launcher",
  "private": true,
  "version": "1.0.0",
  "description": "Windows desktop launcher that auto-detects and opens browser profiles across Chrome, Brave, Edge, and Vivaldi.",
  "author": "Browser Profile Launcher",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node start.js",
    "electron": "npm run build:all && electron .",
    "build": "vite build",
    "build:electron": "node electron/assets/create-icon.js && esbuild electron/main.ts --bundle --platform=node --target=node20 --outfile=electron/main.cjs --external:electron",
    "build:all": "npm run build && npm run build:electron",
    "dist": "npm run build:all && electron-builder --win --x64 --publish never",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "detect": "tsx src/detect/cli.ts",
    "test": "tsx --test src/detect/detect.test.ts"
  },
  "build": {
    "appId": "com.browserprofilelauncher.app",
    "productName": "Browser Profile Launcher",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/app-icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Browser Profile Launcher",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "script": "electron/installer.nsi",
      "warningsAsErrors": false
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ]
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=6.0.0",
    "express": "^4.21.2",
    "dotenv": ">=16.4.0",
    "motion": ">=11.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "autoprefixer": "^10.4.21",
    "electron": ">=34.0.0",
    "electron-builder": ">=25.1.8",
    "esbuild": ">=0.24.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.19.0",
    "typescript": ">=5.6.0"
  }
}
